# API Keys Configuration
# Copy this file to .env and fill in your actual keys
# DO NOT commit .env to git!

# Claude API Key (Anthropic)
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key-here

# OpenAI API Key (ChatGPT)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Gemini API Keys (Google) - Multiple keys supported (comma-separated)
# Get from: https://aistudio.google.com/apikey
# Will automatically rotate to next key on rate limit/failure
GEMINI_API_KEYS=your-key-1,your-key-2,your-key-3

# Grok API Key (xAI)
# Get from: https://console.x.ai/
GROK_API_KEY=your-grok-api-key-here

# AssemblyAI API Key (Speech-to-Text)
# Get from: https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# AWS Polly (Text-to-Speech for voice replies)
# Get from: https://console.aws.amazon.com/iam/
# Create IAM user with AmazonPollyReadOnlyAccess policy
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_REGION=us-east-1
